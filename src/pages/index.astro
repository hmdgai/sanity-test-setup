---
/**
 * Homepage — Meridian Health (test build, fictional client).
 *
 * Visual language: wgb.agency clone (see /brief/meridian-health-brief-v2).
 *   Sections alternate cream and dark backgrounds.
 *   Every major heading uses the mixed-font pattern — heavy sans-serif
 *   with a single italic-serif span via `<em class="display-italic">`.
 *   Primary CTAs are pill buttons with a leading `+` icon.
 *   No photography — all imagery is inline SVG (orbitals, sparkles,
 *   placeholder person tiles).
 *
 * Content split (per brief Section 5):
 *   - Page copy: hardcoded here.
 *   - Testimonials: queried from Sanity at build time.
 *   - Team / pricing / FAQs / contact / location: queried by their own
 *     dedicated pages (not used on the homepage itself).
 */

import BaseLayout from '../layouts/BaseLayout.astro'
import SparkleMark from '../components/SparkleMark.astro'
import DecorativeCross from '../components/DecorativeCross.astro'
import OrbitalDiagram from '../components/OrbitalDiagram.astro'
import PlaceholderPersonTile from '../components/PlaceholderPersonTile.astro'
import { getTestimonials, getTeamMembers } from '../lib/queries'

type Testimonial = {
  _id: string
  quote: string
  author: string
  authorRole?: string
  rating?: number
  order?: number
}

type TeamMember = {
  _id: string
  name: string
  role?: string
  order?: number
}

let testimonials: Testimonial[] = []
let team: TeamMember[] = []
try {
  testimonials = (await getTestimonials()) as Testimonial[] ?? []
} catch (e) {
  testimonials = []
}
try {
  team = (await getTeamMembers()) as TeamMember[] ?? []
} catch (e) {
  team = []
}

/* Strip the "Dr" honorific and take the first letter of the next
   two name parts so "Dr Eleanor Whitfield" → "EW". Pure cosmetic
   — for the placeholder tile when no Sanity photo is present. */
function initialsOf(name: string): string {
  return name
    .split(/\s+/)
    .filter((w) => w.length > 0 && !/^dr\.?$/i.test(w))
    .slice(0, 2)
    .map((w) => w.charAt(0).toUpperCase())
    .join('') || name.slice(0, 2).toUpperCase()
}

/* Duplicate the team list so the marquee can loop seamlessly —
   the animation translates the track by exactly -50% over its
   cycle, landing back on the original starting frame. */
const marqueeMembers = team.length > 0 ? [...team, ...team] : []

/* ── Verbatim copy from brief Section 6.1 ──────────────────────── */
const painPoints = [
  {
    title: 'Your annual check-up tells you nothing useful.',
    body:  'A 20-minute GP appointment and a basic blood panel will not catch the things that will actually end your career — cardiovascular silent decline, early metabolic dysfunction, sleep architecture collapse, cognitive drift.',
  },
  {
    title: "You're reactive when you can afford to be proactive.",
    body:  'By the time symptoms force you to see a doctor, the window for cheap, easy intervention has usually closed. The patients with the best outcomes intervened five years before they had to.',
  },
  {
    title: "You don't have time for the NHS pathway.",
    body:  "A specialist referral that takes nine months is not a healthcare pathway. It's a queue. You don't have nine months.",
  },
  {
    title: "You're already spending the money — badly.",
    body:  'Most executives spend more on supplements, wearables, and reactive private appointments in a year than a Meridian membership costs. Without a physician coordinating any of it.',
  },
  {
    title: 'Generic concierge medicine is just a faster GP.',
    body:  'Paying for fast access to the same generalist with the same training, the same protocols, and the same 12-minute appointment is not the answer. You need a different methodology.',
  },
]

const stats = [
  { value: '300+',  label: 'active members' },
  { value: '£8,500', label: 'from / membership' },
  { value: '94%',   label: 'retention' },
  { value: '4hr',   label: 'avg response' },
]

const pillars = [
  {
    eyebrow: 'Pillar 01',
    title:   'Diagnose',
    italic:  'deeply',
    body:    "We build a baseline using advanced diagnostics most clinics don't have access to. Cardiac CT, advanced lipid panels, continuous glucose monitoring, sleep architecture studies, cognitive baselining.",
    tags:    ['Cardiac', 'Metabolic', 'Cognitive'],
  },
  {
    eyebrow: 'Pillar 02',
    title:   'Intervene',
    italic:  'precisely',
    body:    "Once we know what's actually happening in your body, we intervene on the specific variables that matter — not a generic wellness plan.",
    tags:    ['Sleep', 'Recovery', 'Cognition'],
  },
  {
    eyebrow: 'Pillar 03',
    title:   'Stay',
    italic:  'close',
    body:    'Your physician is reachable by direct line. Quarterly check-ins are the floor, not the ceiling.',
    tags:    ['Direct line', 'Quarterly', 'On-call'],
  },
] as const

const reactivePoints = [
  'Your GP only sees you when something’s already wrong.',
  "You take supplements your doctor doesn't know about.",
  'Your wearables collect data nobody reads.',
  'You treat symptoms in silos.',
]

const meridianPoints = [
  'We baseline you when you’re well, so we notice drift early.',
  'Your physician designs and reviews every protocol.',
  'We turn your wearable data into action.',
  'Everything is coordinated by one team.',
]

const seoSchema = {
  '@context': 'https://schema.org',
  '@type':    'MedicalOrganization',
  name:       'Meridian Health',
  url:        'https://sanity-test-setup.hmdg.workers.dev',
  description: 'Concierge medicine for founders and executives. Mayfair, London.',
  address: {
    '@type':         'PostalAddress',
    streetAddress:   '14 South Audley Street',
    addressLocality: 'London',
    postalCode:      'W1K 1JQ',
    addressCountry:  'GB',
  },
  telephone: '+442079461840',
}
---

<BaseLayout
  title="Meridian Health — Concierge medicine for executives"
  description="Engineering longer, better, sharper lives. Concierge medicine for founders and executives. Mayfair, London. From £8,500/yr."
  schema={seoSchema}
>

  <!-- ════════════════════════════════════════════════════════════
       1. HERO — cream
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-[--color-cream] relative overflow-hidden">
    <div class="container px-[--spacing-section-x] pt-16 pb-24 lg:pt-24 lg:pb-32 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <div class="lg:col-span-7 max-w-[60ch]">
        <span class="eyebrow text-[--color-primary]">Concierge medicine ✦ Mayfair</span>
        <h1 class="text-[--color-headline]">
          Engineering longer, better, <em class="display-italic">sharper lives</em>.
        </h1>
        <p class="mt-8 text-lg lg:text-xl text-[--color-body] max-w-2xl">
          Concierge medicine for founders, executives, and professionals who can't afford
          to be reactive about their health. Membership starts at £8,500 a year.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/book-call" class="meridian-pill">
            <span aria-hidden="true" class="meridian-pill__plus">+</span>
            <span>Book a discovery call</span>
          </a>
          <a href="/membership" class="meridian-pill meridian-pill--dark">
            <span aria-hidden="true" class="meridian-pill__plus">+</span>
            <span>View membership</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <OrbitalDiagram
          labels={['Diagnose', 'Intervene', 'Stay close']}
          glowIntensity={1}
          size={460}
          theme="light"
        />
      </div>

    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════
       2. PAIN POINTS — cream with white cards + one electric-blue accent
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-[--color-cream] border-t border-[--color-border]">
    <div class="container px-[--spacing-section-x] py-20 lg:py-28">

      <div class="max-w-4xl mb-12 lg:mb-16">
        <span class="eyebrow text-[--color-primary]">The problem</span>
        <h2 class="text-[--color-headline]">
          Your career depends on your output. Your output depends on a body and brain you
          treat as an <em class="display-italic">afterthought</em>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {painPoints.map((p, i) => (
          <article class="pain-card">
            <span class="pain-card__x text-[--color-accent-warn]" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
                <line x1="4" y1="4" x2="14" y2="14" /><line x1="14" y1="4" x2="4" y2="14" />
              </svg>
            </span>
            <h3 class="pain-card__title">{p.title}</h3>
            <p class="pain-card__body">{p.body}</p>
          </article>
        ))}

        <!-- Electric-blue accent card with sparkle (Reference 2) -->
        <article class="pain-card pain-card--accent">
          <span class="text-[--color-cream] mb-5 inline-block">
            <SparkleMark size={26} decorative={true} />
          </span>
          <h3 class="pain-card__title text-[--color-headline-inv]">
            Sounds familiar? Here's what we believe.
          </h3>
          <a href="/methodology" class="mt-6 inline-flex items-center gap-2 text-[--color-headline-inv] font-semibold text-sm">
            <span aria-hidden="true" class="meridian-pill__plus">+</span>
            <span>Read our methodology</span>
          </a>
        </article>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════
       3. PROOF — cream, 4 stats strip + CTA
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-[--color-cream-darker]">
    <div class="container px-[--spacing-section-x] py-20 lg:py-28">

      <div class="max-w-3xl mb-12 lg:mb-16">
        <span class="eyebrow text-[--color-primary]">Proof</span>
        <h2 class="text-[--color-headline]">
          Proven with <em class="display-italic">300+ members</em> who trust us with their longevity.
        </h2>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
        {stats.map((s) => (
          <div class="border-t border-[--color-headline]/15 pt-6">
            <div class="font-heading font-extrabold text-4xl lg:text-5xl tracking-[-0.02em] text-[--color-headline]">{s.value}</div>
            <div class="mt-2 text-sm text-[--color-caption] uppercase tracking-[0.14em]">{s.label}</div>
          </div>
        ))}
      </div>

      <a href="/membership" class="meridian-pill">
        <span aria-hidden="true" class="meridian-pill__plus">+</span>
        <span>Explore membership</span>
      </a>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════
       4. TRUST ENGINE — dark, overview heading + orbital
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-[--color-dark] relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 text-[--color-headline-inv]" aria-hidden="true">
      <div class="absolute top-12 right-[10%]"><DecorativeCross size={12} opacity={0.16} /></div>
      <div class="absolute top-[60%] left-[10%]"><DecorativeCross size={10} opacity={0.12} /></div>
      <div class="absolute bottom-16 right-[40%]"><DecorativeCross size={9} opacity={0.18} /></div>
    </div>

    <div class="container px-[--spacing-section-x] py-24 lg:py-32 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">

      <div class="lg:col-span-7">
        <span class="eyebrow text-[--color-primary]">The Meridian Methodology</span>
        <h2 class="text-[--color-headline-inv] max-w-3xl">
          Guiding your <em class="display-italic">longevity</em> beyond reactive medicine.
        </h2>
        <p class="mt-8 text-lg text-[--color-body-inv] max-w-2xl">
          The Meridian Methodology replaces the chaos of fragmented healthcare — your GP,
          your therapist, your nutritionist, your gym, your wearable — with one
          coordinated team and one engineered protocol. Designed around how senior
          careers actually work.
        </p>
      </div>

      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <OrbitalDiagram
          labels={['Diagnose', 'Intervene', 'Stay close']}
          glowIntensity={2}
          size={420}
          theme="dark"
        />
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════
       5. THREE PILLARS — dark, progressive orbital glow
       ════════════════════════════════════════════════════════════ -->
  {pillars.map((p, i) => (
    <section class="bg-[--color-dark] relative overflow-hidden border-t border-[--color-border-dark]">
      <div class="container px-[--spacing-section-x] py-20 lg:py-28 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

        <div class="lg:col-span-7">
          <span class="eyebrow text-[--color-primary]">{p.eyebrow}</span>
          <h3 class="text-[--color-headline-inv] !text-[clamp(2rem,2.5vw+1rem,3.75rem)] !leading-[1.05] !font-extrabold">
            {p.title} <em class="display-italic">{p.italic}</em>.
          </h3>
          <p class="mt-6 text-lg text-[--color-body-inv] max-w-2xl">{p.body}</p>

          <div class="mt-8 flex flex-wrap gap-2">
            {p.tags.map((t) => (
              <span class="pillar-tag">{t}</span>
            ))}
          </div>

          <a href="/methodology" class="mt-10 meridian-pill inline-flex">
            <span aria-hidden="true" class="meridian-pill__plus">+</span>
            <span>Discover our approach</span>
          </a>
        </div>

        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <OrbitalDiagram
            labels={['Diagnose', 'Intervene', 'Stay close']}
            glowIntensity={(i + 1) as 1 | 2 | 3}
            size={380}
            theme="dark"
          />
        </div>
      </div>
    </section>
  ))}


  <!-- ════════════════════════════════════════════════════════════
       5.5  TEAM MARQUEE — cream, continuous horizontal loop
            Breaks the dark pillar run and previews the team page
            with placeholder tiles. Data pulled from Sanity.
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-[--color-cream]">
    <div class="container px-[--spacing-section-x] pt-24 lg:pt-32 pb-20 lg:pb-28">
      <div class="max-w-4xl mb-12 lg:mb-16">
        <span class="eyebrow text-[--color-primary]">The team</span>
        <h2 class="text-[--color-headline]">
          The people behind your <em class="display-italic">protocol</em>.
        </h2>
        <p class="mt-6 text-lg text-[--color-body] max-w-2xl">
          Meridian is a small team by design. Every member sees the same physicians, and
          the team behind your care knows your full history before they walk into the
          room.
        </p>
      </div>
    </div>

    {team.length > 0 ? (
      <div class="team-marquee" aria-label="Meridian physicians">
        <div class="team-marquee__track">
          {marqueeMembers.map((m, i) => (
            <article
              class="team-card"
              aria-hidden={i >= team.length ? 'true' : undefined}
            >
              <div class="team-card__tile">
                <PlaceholderPersonTile
                  initials={initialsOf(m.name)}
                  name={m.name}
                  size={320}
                />
              </div>
              <div class="team-card__meta">
                <h3 class="team-card__name">{m.name}</h3>
                {m.role && <p class="team-card__role">{m.role}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    ) : (
      <div class="container px-[--spacing-section-x]">
        <p class="text-sm text-[--color-caption]">
          Team members will appear here once published in Sanity (Studio → Team Members → Publish).
        </p>
      </div>
    )}

    <div class="container px-[--spacing-section-x] pt-12 lg:pt-16 pb-24 lg:pb-32 flex flex-wrap items-center gap-3">
      <a href="/team" class="meridian-pill meridian-pill--dark">
        <span aria-hidden="true" class="meridian-pill__plus">+</span>
        <span>Meet the team</span>
      </a>
      <a href="/book-call" class="meridian-pill">
        <span aria-hidden="true" class="meridian-pill__plus">+</span>
        <span>Book a discovery call</span>
      </a>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════
       6. COMPARISON — cream, two columns (Reactive vs Meridian)
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-[--color-cream]">
    <div class="container px-[--spacing-section-x] py-24 lg:py-32">

      <div class="max-w-4xl mb-14 lg:mb-20">
        <span class="eyebrow text-[--color-primary]">The choice</span>
        <h2 class="text-[--color-headline]">
          Stop relying on <em class="display-italic">reactive medicine</em>.
        </h2>
        <p class="mt-6 text-lg text-[--color-body] max-w-3xl">
          You cannot engineer outcomes with sporadic GP visits and supplement guesswork.
          Long-term health depends on coordinated, proactive medicine.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <!-- Reactive (orange X) -->
        <div class="compare-col">
          <span class="eyebrow text-[--color-accent-warn] mb-4">Reactive medicine</span>
          <ul class="space-y-5 mt-2">
            {reactivePoints.map((point) => (
              <li class="flex items-start gap-3">
                <span class="compare-icon compare-icon--warn shrink-0" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
                    <line x1="3" y1="3" x2="11" y2="11" /><line x1="11" y1="3" x2="3" y2="11" />
                  </svg>
                </span>
                <span class="text-base text-[--color-body]">{point}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Meridian (electric blue sparkle) -->
        <div class="compare-col compare-col--solution">
          <span class="eyebrow text-[--color-primary] mb-4">The Meridian Methodology</span>
          <ul class="space-y-5 mt-2">
            {meridianPoints.map((point) => (
              <li class="flex items-start gap-3">
                <span class="compare-icon compare-icon--accent shrink-0 text-[--color-primary]" aria-hidden="true">
                  <SparkleMark size={14} />
                </span>
                <span class="text-base text-[--color-body]">{point}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════
       7. TESTIMONIALS — cream, masonry of cards (from Sanity)
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-[--color-cream-darker]">
    <div class="container px-[--spacing-section-x] py-24 lg:py-32">

      <div class="max-w-4xl mb-12 lg:mb-16">
        <span class="eyebrow text-[--color-primary]">Members on Meridian</span>
        <h2 class="text-[--color-headline]">
          We treat your <em class="display-italic">health</em> like it's our own.
        </h2>
        <p class="mt-6 text-lg text-[--color-body] max-w-2xl">
          You don't just hire a private doctor. You hire a team that engineers your
          outcomes with the same obsession we apply to our own families.
        </p>
      </div>

      {testimonials.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {testimonials.map((t) => (
            <article class="testimonial-card">
              <span class="text-[--color-primary] mb-5 inline-block" aria-hidden="true">
                <SparkleMark size={16} />
              </span>
              <blockquote class="text-[--color-headline] text-lg leading-snug font-medium mb-6">
                "{t.quote}"
              </blockquote>
              <footer class="text-sm">
                <div class="font-semibold text-[--color-headline]">{t.author}</div>
                {t.authorRole && <div class="text-[--color-caption]">{t.authorRole}</div>}
              </footer>
            </article>
          ))}
        </div>
      ) : (
        <div class="testimonial-card max-w-xl">
          <p class="text-sm text-[--color-caption]">
            Testimonials will appear here once published in Sanity. Open Studio →
            Testimonials → click each entry → click Publish.
          </p>
        </div>
      )}

      <div class="mt-12 flex flex-wrap items-center gap-3">
        <a href="/membership" class="meridian-pill meridian-pill--dark">
          <span aria-hidden="true" class="meridian-pill__plus">+</span>
          <span>Explore membership</span>
        </a>
        <a href="/book-call" class="meridian-pill">
          <span aria-hidden="true" class="meridian-pill__plus">+</span>
          <span>Book a call</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Pill CTA — shared by hero, proof, pillars, testimonials.
        --dark variant uses near-black with a cream label so it
        reads against the electric blue primary on cream sections. */
  .meridian-pill {
    display:          inline-flex;
    align-items:      center;
    gap:              0.5rem;
    height:           3rem;
    padding:          0 1.5rem;
    background-color: var(--color-primary);
    color:            #FBF1E4;
    font-family:      var(--font-body);
    font-size:        0.875rem;
    font-weight:      600;
    letter-spacing:   0.02em;
    border-radius:    9999px;
    border:           1px solid var(--color-primary);
    text-decoration:  none;
    transition:       background-color 0.2s ease, transform 0.15s ease, color 0.2s ease;
    white-space:      nowrap;
  }
  .meridian-pill:hover {
    background-color: var(--color-primary-hover);
    color:            #FBF1E4;
    transform:        translateY(-1px);
  }
  .meridian-pill:focus-visible {
    outline:          2px solid var(--color-primary);
    outline-offset:   3px;
  }
  .meridian-pill__plus {
    font-size:    1.125rem;
    line-height:  1;
    margin-top:   -0.125rem;
  }
  .meridian-pill--dark {
    background-color: var(--color-dark);
    border-color:     var(--color-dark);
  }
  .meridian-pill--dark:hover {
    background-color: #000000;
    color:            #FBF1E4;
  }

  /* ── Pain-point card — white surface on cream, thin border, no shadow */
  .pain-card {
    background-color: #ffffff;
    border:           1px solid var(--color-border);
    border-radius:    0.75rem;
    padding:          2rem 1.75rem 1.75rem;
    display:          flex;
    flex-direction:   column;
    transition:       border-color 0.2s ease, transform 0.2s ease;
  }
  .pain-card:hover {
    border-color: rgba(10, 10, 10, 0.18);
    transform:    translateY(-2px);
  }
  .pain-card__x {
    display:         inline-flex;
    width:           2.25rem;
    height:          2.25rem;
    border-radius:   0.5rem;
    background-color: rgba(255, 77, 20, 0.08);
    align-items:     center;
    justify-content: center;
    margin-bottom:   1.5rem;
  }
  .pain-card__title {
    font-family:    var(--font-heading);
    font-size:      1.25rem;
    line-height:    1.25;
    letter-spacing: -0.015em;
    font-weight:    700;
    color:          var(--color-headline);
    margin:         0 0 0.75rem;
  }
  .pain-card__body {
    color:        var(--color-body);
    font-size:    0.9375rem;
    line-height:  1.65;
    margin:       0;
  }
  .pain-card--accent {
    background-color: var(--color-primary);
    border-color:     var(--color-primary);
