---
/**
 * DecorativeCross — the small `+` marks scattered on dark sections
 * to suggest depth (Reference 5–7 of the brief). Decorative only.
 *
 * Props:
 *   size    — px width/height. Default 12.
 *   opacity — 0–1. Default 0.18. Keep low — never above 0.3.
 *   class   — extra utility classes.
 */
interface Props {
  size?: number
  opacity?: number
  class?: string
}

const {
  size = 12,
  opacity = 0.18,
  class: className = '',
} = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 12 12"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="square"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  style={`opacity: ${opacity}`}
  aria-hidden="true"
  focusable="false"
>
  <line x1="6" y1="1.5" x2="6" y2="10.5" />
  <line x1="1.5" y1="6" x2="10.5" y2="6" />
</svg>
