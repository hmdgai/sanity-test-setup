---
/**
 * PlaceholderPersonTile — solid electric-blue square with cream
 * initials in heavy sans (Section 7.1 of the brief). Replaces
 * stock photography of doctors for the test build.
 *
 * Inline SVG so the tile is GPU-cheap, prints clean, and never
 * triggers a network request. Square aspect ratio (1:1).
 *
 * Props:
 *   initials — 1–3 chars. Required.
 *   name     — accessible name (full team-member name).
 *   size     — px width/height. Default 320.
 *   class    — extra utility classes on the wrapper.
 *   variant  — "primary" (cream-on-blue, default) | "inverse" (blue-on-cream)
 */
interface Props {
  initials: string
  name?: string
  size?: number
  class?: string
  variant?: 'primary' | 'inverse'
}

const {
  initials,
  name,
  size = 320,
  class: className = '',
  variant = 'primary',
} = Astro.props

const isPrimary = variant === 'primary'
const bg     = isPrimary ? '#1A1AFF' : '#FBF1E4'
const fg     = isPrimary ? '#FBF1E4' : '#0A0A0A'
const trimmed = initials.trim().slice(0, 3).toUpperCase()

/* Tile size drives the type size — bigger tiles need bigger text. */
const textPx = Math.round(size * 0.42)
---

<svg
  width={size}
  height={size}
  viewBox="0 0 320 320"
  preserveAspectRatio="xMidYMid meet"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={name ? 'img' : 'presentation'}
  aria-label={name}
  focusable="false"
>
  <rect width="320" height="320" fill={bg} />
  <text
    x="160"
    y="160"
    text-anchor="middle"
    dominant-baseline="central"
    fill={fg}
    font-family="'Inter Tight Variable', 'Inter Tight', sans-serif"
    font-weight="800"
    font-size={textPx}
    letter-spacing="-4"
  >{trimmed}</text>
</svg>
