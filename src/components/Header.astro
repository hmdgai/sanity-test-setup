---
/**
 * Header.astro — WGB-style minimal nav for Meridian Health.
 * Cloned from wgb.agency Reference 1: cream background, wordmark
 * lockup with ✦ mark, 5–6 plain text nav links, electric-blue pill
 * CTA with a leading + icon on the right. Mobile collapses to a
 * full-width slide-down panel.
 *
 * Used once in BaseLayout.astro. Never duplicate per-page.
 *
 * ── Active-state system (MANDATORY) ─────────────────────────────
 *   isActive(href)    — exact-match leaf link
 *   isSection(prefix) — dropdown / mid-level flyout triggers
 * See .claude/rules/frontend.md → "Navigation Active State".
 */

import SparkleMark from './SparkleMark.astro'

const currentPath = Astro.url.pathname

const isActive = (href: string): boolean => {
  if (href === '/') return currentPath === '/'
  const norm = href.endsWith('/') ? href : href + '/'
  return currentPath === norm || currentPath === norm.slice(0, -1)
}

const isSection = (prefix: string): boolean => currentPath.startsWith(prefix)

/* Top-level nav per brief Section 4.1. /services is a hub page with
   sub-pages so it uses isSection — visiting /services/longevity-screening
   still highlights the parent. Same for /methodology and /membership
   (kept on isActive for now since the brief doesn't define children
   under those routes). */
const homeActive       = isActive('/')
const methodologyActive = isSection('/methodology')
const servicesActive   = isSection('/services')
const membershipActive = isSection('/membership')
const insightsActive   = isSection('/insights')
const aboutActive      = isSection('/about')

const navLinks = [
  { href: '/',             label: 'Home',         active: homeActive },
  { href: '/methodology',  label: 'Methodology',  active: methodologyActive },
  { href: '/services',     label: 'Services',     active: servicesActive },
  { href: '/membership',   label: 'Membership',   active: membershipActive },
  { href: '/insights',     label: 'Insights',     active: insightsActive },
  { href: '/about',        label: 'About',        active: aboutActive },
] as const
---

<header class="site-header sticky top-0 z-50 bg-[--color-cream]">
  <div class="container px-[--spacing-section-x] py-5 flex items-center justify-between gap-8">

    <!-- ── Logo lockup: ✦ + wordmark ────────────────────────── -->
    <a
      href="/"
      class="meridian-lockup inline-flex items-center gap-2.5 text-[--color-headline] hover:text-[--color-primary] transition-colors"
      aria-label="Meridian Health — home"
    >
      <SparkleMark size={18} class="text-[--color-primary]" />
      <span class="font-heading font-extrabold text-lg tracking-[-0.02em] lowercase">meridian</span>
    </a>

    <!-- ── Desktop nav ──────────────────────────────────────── -->
    <nav
      class="hidden lg:flex items-center gap-8 text-sm font-medium text-[--color-body]"
      aria-label="Main navigation"
    >
      {navLinks.map(({ href, label, active }) => (
        <a
          href={href}
          class:list={[
            'site-nav-item transition-colors hover:text-[--color-primary]',
            { 'is-active': active },
          ]}
        >{label}</a>
      ))}
    </nav>

    <!-- ── Right side: CTA pill (and hamburger on mobile) ───── -->
    <div class="flex items-center gap-3">
      <a
        href="/book-call"
        class="meridian-cta hidden lg:inline-flex items-center gap-2"
      >
        <span aria-hidden="true" class="meridian-cta__plus">+</span>
        <span>Book a discovery call</span>
      </a>

      <button
        class="lg:hidden flex flex-col items-center justify-center gap-1.5 w-11 h-11 -mr-2 rounded-full"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-toggle"
      >
        <span class="block w-5 h-0.5 bg-[--color-headline]"></span>
        <span class="block w-5 h-0.5 bg-[--color-headline]"></span>
      </button>
    </div>

  </div>

  <!-- ── Mobile slide-down ──────────────────────────────────── -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden bg-[--color-cream] border-t border-[--color-border]"
    aria-hidden="true"
  >
    <nav class="px-[--spacing-section-x] py-6 flex flex-col gap-1" aria-label="Mobile navigation">
      {navLinks.map(({ href, label, active }) => (
        <a
          href={href}
          class:list={[
            'mobile-nav-item site-nav-item py-3 text-base font-medium text-[--color-body] hover:text-[--color-primary] transition-colors',
            { 'is-active': active },
          ]}
        >{label}</a>
      ))}
      <a href="/book-call" class="meridian-cta inline-flex items-center gap-2 self-start mt-4">
        <span aria-hidden="true" class="meridian-cta__plus">+</span>
        <span>Book a discovery call</span>
      </a>
    </nav>
  </div>
</header>

<style>
  /* Sticky header surface — explicit background + thin bottom border
     so the bar stays visible against any section behind it (cream
     hero, dark Trust Engine section, etc.). Independent of any
     Tailwind utility resolution. */
  .site-header {
    background-color: var(--color-cream);
    border-bottom:    1px solid var(--color-border);
    /* Subtle elevation appears once user scrolls past hero — the
       sticky-positioned element gets the shadow as soon as it's
       offset from its natural top. */
  }
  /* Backdrop blur for browsers that support it — gives the header
     a frosted-glass feel when sitting over content. Falls back
     to the solid background above. */
  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      background-color: rgb(251 241 228 / 0.85);
      backdrop-filter:  saturate(180%) blur(10px);
    }
  }

  /* WGB pill CTA — electric blue, all-caps tracking, leading + glyph.
     Uses --color-primary so the same token swap from global.css drives
     it. Sharp 999px radius (full pill), generous horizontal padding,
     subtle scale on hover. */
  .meridian-cta {
    display:          inline-flex;
    align-items:      center;
    gap:              0.5rem;
    height:           2.75rem;        /* 44px — meets touch target rule */
    padding:          0 1.25rem;
    background-color: var(--color-primary);
    color:            #FBF1E4;        /* cream on blue */
    font-family:      var(--font-body);
    font-size:        0.8125rem;      /* 13px */
    font-weight:      600;
    letter-spacing:   0.02em;
    border-radius:    9999px;
    border:           1px solid var(--color-primary);
    text-decoration:  none;
    transition:       background-color 0.2s ease, transform 0.15s ease, color 0.2s ease;
    white-space:      nowrap;
  }
  .meridian-cta:hover {
    background-color: var(--color-primary-hover);
    color:            #FBF1E4;
    transform:        translateY(-1px);
  }
  .meridian-cta:focus-visible {
    outline:          2px solid var(--color-primary);
    outline-offset:   3px;
  }
  .meridian-cta__plus {
    font-size:    1.125rem;
    font-weight:  400;
    line-height:  1;
    margin-top:   -0.125rem;          /* optical centre */
  }
</style>

<script>
  /* Progressive enhancement — toggles the mobile panel */
  const toggle = document.getElementById('mobile-menu-toggle')
  const menu   = document.getElementById('mobile-menu')
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden')
      menu.classList.toggle('hidden', isOpen)
      menu.setAttribute('aria-hidden', String(isOpen))
      toggle.setAttribute('aria-expanded', String(!isOpen))
    })
  }
</script>
