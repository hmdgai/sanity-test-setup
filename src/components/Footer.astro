---
/**
 * Footer.astro — WGB Reference 10 for Meridian Health.
 *
 * Dark background, single electric-blue diagonal sweep, a "Talk to a
 * physician, not a salesperson" CTA card sitting in front of a large
 * `meridian` + ✦ wordmark, then a multi-column footer below.
 *
 * Pulls phone, email, social links from Sanity contactDetails, and the
 * primary location from Sanity location. Falls back to brief values
 * when Sanity is unreachable so the page never renders broken.
 *
 * Active-state system (.footer-link is-active) preserved from the
 * HMDG template — see .claude/rules/frontend.md.
 */

import SparkleMark from './SparkleMark.astro'
import DecorativeCross from './DecorativeCross.astro'
import DiagonalSweep from './DiagonalSweep.astro'
import PlaceholderPersonTile from './PlaceholderPersonTile.astro'
import { getContactDetails, getLocations } from '../lib/queries'

/* ── Sanity-backed values with brief-derived fallbacks ───────── */
type ContactDetails = {
  primaryEmail?: string
  primaryPhone?: string
  socialLinks?: { instagram?: string; linkedin?: string }
} | null

type Location = {
  name?: string
  addressLine1?: string
  addressLine2?: string
  city?: string
  postcode?: string
  phone?: string
  email?: string
  openingHours?: { day: string; hours: string }[]
} | null

let contact: ContactDetails = null
let location: Location = null
try {
  contact  = await getContactDetails() as ContactDetails
  const locs = await getLocations() as Location[]
  location = locs?.[0] ?? null
} catch (e) {
  /* Build-time Sanity failure — fall through to fallback values */
}

const phone   = contact?.primaryPhone ?? '020 7946 1840'
const email   = contact?.primaryEmail ?? 'concierge@meridianhealth.fictitious'
const tel     = (phone || '').replace(/\s+/g, '')
const instagramUrl = contact?.socialLinks?.instagram
const linkedinUrl  = contact?.socialLinks?.linkedin

const addressLine1 = location?.addressLine1 ?? '14 South Audley Street'
const city         = location?.city         ?? 'London'
const postcode     = location?.postcode     ?? 'W1K 1JQ'
const hours        = location?.openingHours ?? []

/* ── Active-state booleans ───────────────────────────────────── */
const currentPath = Astro.url.pathname
const isActive = (href: string): boolean => {
  if (href === '/') return currentPath === '/'
  const norm = href.endsWith('/') ? href : href + '/'
  return currentPath === norm || currentPath === norm.slice(0, -1)
}
const isSection = (prefix: string): boolean => currentPath.startsWith(prefix)

const homeActive         = isActive('/')
const methodologyActive  = isSection('/methodology')
const servicesActive     = isSection('/services')
const membershipActive   = isSection('/membership')
const aboutActive        = isSection('/about')
const contactActive      = isActive('/contact')
const privacyActive      = isActive('/privacy-policy')
const termsActive        = isActive('/terms-conditions')
const cookieActive       = isActive('/cookie-policy')

const year = new Date().getFullYear()
---

<footer class="bg-[--color-dark] text-[--color-body-inv] relative overflow-hidden">

  <!-- ── Decorative + crosses scattered low-opacity on dark bg ───── -->
  <div class="pointer-events-none absolute inset-0 text-[--color-headline-inv]" aria-hidden="true">
    <div class="absolute top-16  left-[12%]  text-[--color-headline-inv]"><DecorativeCross size={10} opacity={0.16} /></div>
    <div class="absolute top-40  right-[18%] text-[--color-headline-inv]"><DecorativeCross size={14} opacity={0.10} /></div>
    <div class="absolute top-[44%] left-[28%] text-[--color-headline-inv]"><DecorativeCross size={8}  opacity={0.18} /></div>
    <div class="absolute bottom-[20%] right-[8%] text-[--color-headline-inv]"><DecorativeCross size={12} opacity={0.12} /></div>
    <div class="absolute bottom-32 left-[6%]  text-[--color-headline-inv]"><DecorativeCross size={10} opacity={0.14} /></div>
  </div>

  <!-- ── Top: CTA card sitting in front of huge wordmark ─────────── -->
  <div class="relative px-[--spacing-section-x] pt-20 pb-12 lg:pt-28 lg:pb-20">
    <div class="container relative">

      <!-- Diagonal sweep behind the large wordmark — sits under everything else -->
      <div class="absolute inset-x-0 bottom-0 h-[60%] pointer-events-none -z-0" aria-hidden="true">
        <DiagonalSweep direction="tl-br" colour="#1A1AFF" opacity={0.18} />
      </div>

      <!-- "Talk to a physician" CTA card -->
      <div class="relative z-10 max-w-3xl">
        <span class="inline-block text-[--color-primary] mb-6">
          <SparkleMark size={20} />
        </span>
        <h2 class="text-[--color-headline-inv] mb-6">
          Talk to a <em class="display-italic">physician</em>, not a salesperson.
        </h2>
        <p class="text-[--color-body-inv] text-base lg:text-lg max-w-xl mb-8">
          All membership conversations start with a 30-minute call with Dr Whitfield. No
          sales pitch. No pressure. If we're not the right fit, she'll tell you.
        </p>
        <a href="/book-call" class="meridian-cta-dark inline-flex items-center gap-2">
          <span aria-hidden="true" class="meridian-cta-dark__plus">+</span>
          <span>Book a discovery call</span>
        </a>

        <!-- Author photos cluster — Reference 10 -->
        <div class="mt-10 flex items-center gap-4">
          <div class="flex -space-x-3">
            <div class="ring-2 ring-[--color-dark] rounded-md overflow-hidden">
              <PlaceholderPersonTile initials="EW" name="Dr Eleanor Whitfield" size={48} />
            </div>
            <div class="ring-2 ring-[--color-dark] rounded-md overflow-hidden">
              <PlaceholderPersonTile initials="MH" name="Dr Marcus Holloway" size={48} />
            </div>
            <div class="ring-2 ring-[--color-dark] rounded-md overflow-hidden">
              <PlaceholderPersonTile initials="SR" name="Dr Saskia Reinhardt" size={48} />
            </div>
          </div>
          <span class="text-[--color-body-inv] text-sm">300+ members. 4.9 avg.</span>
        </div>
      </div>

      <!-- Oversized wordmark sitting behind the bottom right -->
      <div
        class="absolute right-0 -bottom-6 lg:-bottom-12 pointer-events-none select-none z-0"
        aria-hidden="true"
      >
        <span class="font-heading font-extrabold tracking-[-0.04em] lowercase leading-[0.8] text-[--color-headline-inv]/[0.06] text-[clamp(8rem,18vw,18rem)]">
          meridian
        </span>
      </div>
    </div>
  </div>

  <!-- ── Main columns ─────────────────────────────────────────────── -->
  <div class="relative z-10 px-[--spacing-section-x] py-16 border-t border-[--color-border-dark]">
    <div class="container grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">

      <!-- Brand column -->
      <div class="flex-layout flex-layout--col gap-5">
        <div class="inline-flex items-center gap-2.5 text-[--color-headline-inv]">
          <span class="text-[--color-primary]">
            <SparkleMark size={18} />
          </span>
          <span class="font-heading font-extrabold text-xl tracking-[-0.02em] lowercase">meridian</span>
        </div>
        <p class="text-sm text-[--color-caption] italic" style="font-family: var(--font-serif-italic);">engineered medicine</p>
        <p class="text-sm text-[--color-body-inv] leading-relaxed max-w-xs">
          Concierge medicine for founders, executives, and professionals who can't afford
          to be reactive about their health.
        </p>
      </div>

      <!-- Explore -->
      <div class="flex-layout flex-layout--col gap-5">
        <span class="text-xs font-semibold text-[--color-headline-inv] uppercase tracking-[0.14em]">
          Explore
        </span>
        <nav class="flex-layout flex-layout--col gap-3" aria-label="Footer navigation">
          <a href="/"            class:list={['footer-link text-sm', { 'is-active': homeActive }]}>Home</a>
          <a href="/methodology" class:list={['footer-link text-sm', { 'is-active': methodologyActive }]}>Methodology</a>
          <a href="/services"    class:list={['footer-link text-sm', { 'is-active': servicesActive }]}>Services</a>
          <a href="/membership"  class:list={['footer-link text-sm', { 'is-active': membershipActive }]}>Membership</a>
          <a href="/about"       class:list={['footer-link text-sm', { 'is-active': aboutActive }]}>About</a>
          <a href="/contact"     class:list={['footer-link text-sm', { 'is-active': contactActive }]}>Contact</a>
        </nav>
      </div>

      <!-- Diagnostics -->
      <div class="flex-layout flex-layout--col gap-5">
        <span class="text-xs font-semibold text-[--color-headline-inv] uppercase tracking-[0.14em]">
          Diagnostics
        </span>
        <nav class="flex-layout flex-layout--col gap-3" aria-label="Diagnostics navigation">
          <a href="/services/executive-assessment"     class="footer-link text-sm">Executive Assessment</a>
          <a href="/services/longevity-screening"      class="footer-link text-sm">Longevity Screening</a>
          <a href="/services/performance-optimisation" class="footer-link text-sm">Performance Optimisation</a>
          <a href="/services/mental-wellness"          class="footer-link text-sm">Mental Wellness</a>
        </nav>
      </div>

      <!-- Contact + hours -->
      <div class="flex-layout flex-layout--col gap-5">
        <span class="text-xs font-semibold text-[--color-headline-inv] uppercase tracking-[0.14em]">
          Contact
        </span>
        <address class="not-italic flex-layout flex-layout--col gap-1 text-sm text-[--color-body-inv]">
          <span>{addressLine1}</span>
          <span>{city}, {postcode}</span>
        </address>
        <div class="flex-layout flex-layout--col gap-1">
          <a href={`tel:${tel}`}      class="text-sm text-[--color-body-inv] hover:text-[--color-headline-inv] transition-colors">{phone}</a>
          <a href={`mailto:${email}`} class="text-sm text-[--color-body-inv] hover:text-[--color-headline-inv] transition-colors">{email}</a>
        </div>
        {hours.length > 0 && (
          <div class="flex-layout flex-layout--col gap-1 mt-2">
            <span class="text-xs font-semibold text-[--color-headline-inv] uppercase tracking-[0.14em] mb-1">Hours</span>
            {hours.map((h) => (
              <span class="text-xs text-[--color-caption]">
                <span class="text-[--color-body-inv]">{h.day}</span> &nbsp; {h.hours}
              </span>
            ))}
          </div>
        )}
        {(instagramUrl || linkedinUrl) && (
          <div class="flex items-center gap-4 mt-2">
            {instagramUrl && <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="footer-link text-sm">Instagram</a>}
            {linkedinUrl  && <a href={linkedinUrl}  target="_blank" rel="noopener noreferrer" class="footer-link text-sm">LinkedIn</a>}
          </div>
        )}
      </div>

    </div>
  </div>

  <!-- ── Bottom strip ─────────────────────────────────────────────── -->
  <div class="relative z-10 border-t border-[--color-border-dark]">
    <div class="container px-[--spacing-section-x] py-5 flex items-center flex-wrap gap-5 justify-between">
      <div class="flex items-center flex-wrap gap-5">
        <span class="text-xs text-[--color-caption]">© {year} Meridian Health Ltd</span>
        <span class="text-xs text-[--color-caption]">
          Designed &amp; Developed by
          <a href="https://hmdg.co.uk/" target="_blank" rel="noopener noreferrer" class="text-[--color-headline-inv] font-semibold hover:opacity-80 transition-opacity">HMDG</a>
        </span>
      </div>
      <nav class="flex items-center flex-wrap gap-5" aria-label="Legal">
        <a href="/privacy-policy"    class:list={['footer-link text-xs', { 'is-active': privacyActive }]}>Privacy Policy</a>
        <a href="/terms-conditions"  class:list={['footer-link text-xs', { 'is-active': termsActive }]}>Terms &amp; Conditions</a>
        <a href="/cookie-policy"     class:list={['footer-link text-xs', { 'is-active': cookieActive }]}>Cookie Policy</a>
      </nav>
    </div>
  </div>

</footer>

<style>
  /* Dark-bg variant of the WGB pill CTA. Cream → blue on hover for a
     stronger pop against the near-black footer. */
  .meridian-cta-dark {
    display:          inline-flex;
    align-items:      center;
    gap:              0.5rem;
    height:           2.75rem;
    padding:          0 1.25rem;
    background-color: var(--color-primary);
    color:            #FBF1E4;
    font-family:      var(--font-body);
    font-size:        0.8125rem;
    font-weight:      600;
    letter-spacing:   0.02em;
    border-radius:    9999px;
    border:           1px solid var(--color-primary);
    text-decoration:  none;
    transition:       background-color 0.2s ease, transform 0.15s ease;
    white-space:      nowrap;
  }
  .meridian-cta-dark:hover {
    background-color: var(--color-primary-hover);
    color:            #FBF1E4;
    transform:        translateY(-1px);
  }
  .meridian-cta-dark:focus-visible {
    outline:          2px solid #FBF1E4;
    outline-offset:   3px;
  }
  .meridian-cta-dark__plus {
    font-size:   1.125rem;
    line-height: 1;
    margin-top:  -0.125rem;
  }
</style>
